<?xml version="1.0" ?>
<sdf version="1.9">
<world name="warehouse_world">

<scene>
  <ambient>0.85 0.85 0.85 1</ambient>
  <background>0.9 0.9 0.9 1</background>
  <shadows>false</shadows>
</scene>

<physics name="physics" type="ode">
  <max_step_size>0.001</max_step_size>
  <real_time_factor>1.0</real_time_factor>
  <real_time_update_rate>1000</real_time_update_rate>
</physics>

<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
  <render_engine>ogre2</render_engine>
</plugin>

<light type="directional" name="sun">
  <cast_shadows>false</cast_shadows>
  <pose>0 0 20 0 0 0</pose>
  <diffuse>1 1 1 1</diffuse>
  <specular>0.5 0.5 0.5 1</specular>
  <direction>-0.3 0.3 -1</direction>
</light>

<model name="ground">
  <static>true</static>
  <link name="ground_link">
    <collision name="collision">
      <geometry><plane><normal>0 0 1</normal><size>18 14</size></plane></geometry>
      <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
    </collision>
    <visual name="visual">
      <geometry><plane><normal>0 0 1</normal><size>18 14</size></plane></geometry>
      <material><ambient>0.28 0.28 0.32 1</ambient><diffuse>0.28 0.28 0.32 1</diffuse></material>
    </visual>
  </link>
</model>

<model name="floor_markings">
  <static>true</static>
  <link name="main_lane_center_line">
    <pose>1.2 0 0.006 0 0 0</pose>
    <visual name="visual"><geometry><box><size>0.08 10.8 0.01</size></box></geometry><material><ambient>1.0 0.75 0.05 1</ambient><diffuse>1.0 0.75 0.05 1</diffuse></material></visual>
  </link>
  <link name="crossing_lane">
    <pose>0 0.0 0.007 0 0 0</pose>
    <visual name="visual"><geometry><box><size>7.5 0.08 0.01</size></box></geometry><material><ambient>1.0 0.75 0.05 1</ambient><diffuse>1.0 0.75 0.05 1</diffuse></material></visual>
  </link>
  <link name="robot_start_zone">
    <pose>-1.2 0.8 0.008 0 0 0</pose>
    <visual name="visual"><geometry><box><size>1.2 1.0 0.01</size></box></geometry><material><ambient>0.1 0.45 1.0 0.75</ambient><diffuse>0.1 0.45 1.0 0.75</diffuse></material></visual>
  </link>
  <link name="crossing_zone">
    <pose>1.2 0.0 0.009 0 0 0</pose>
    <visual name="visual"><geometry><box><size>1.4 1.4 0.01</size></box></geometry><material><ambient>1.0 0.15 0.05 0.65</ambient><diffuse>1.0 0.15 0.05 0.65</diffuse></material></visual>
  </link>
  <link name="head_on_zone">
    <pose>3.8 0.0 0.009 0 0 0</pose>
    <visual name="visual"><geometry><box><size>1.4 2.6 0.01</size></box></geometry><material><ambient>0.9 0.1 0.9 0.6</ambient><diffuse>0.9 0.1 0.9 0.6</diffuse></material></visual>
  </link>
  <link name="parking_zone">
    <pose>6.4 -5.2 0.009 0 0 0</pose>
    <visual name="visual"><geometry><box><size>1.4 1.2 0.01</size></box></geometry><material><ambient>0.1 0.9 0.25 0.65</ambient><diffuse>0.1 0.9 0.25 0.65</diffuse></material></visual>
  </link>
  <link name="prediction_test_zone">
    <pose>-3.8 -4.6 0.009 0 0 0</pose>
    <visual name="visual"><geometry><box><size>2.0 1.0 0.01</size></box></geometry><material><ambient>0.0 0.9 0.9 0.6</ambient><diffuse>0.0 0.9 0.9 0.6</diffuse></material></visual>
  </link>
</model>

<model name="warehouse_walls">
  <static>true</static>
  <link name="north_wall"><pose>0 7 1 0 0 0</pose><collision name="collision"><geometry><box><size>18 0.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.2 2</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link>
