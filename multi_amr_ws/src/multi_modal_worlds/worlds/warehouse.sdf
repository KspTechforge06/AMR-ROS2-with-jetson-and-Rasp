<model name="forklift_1">
  <static>false</static>
  <self_collide>false</self_collide>
  <pose>1.2 0.0 0 0 0 1.57</pose>

  <link name="base_link">
    <inertial>
      <pose>0 0 0.11 0 0 0</pose>
      <mass>10.0</mass>
      <inertia>
        <ixx>0.45</ixx>
        <iyy>0.55</iyy>
        <izz>0.45</izz>
      </inertia>
    </inertial>

    <collision name="body_collision">
      <pose>0 0 0.18 0 0 0</pose>
      <geometry><box><size>0.56 0.34 0.18</size></box></geometry>
      <surface>
        <contact><ode><kp>50000</kp><kd>40</kd></ode></contact>
        <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
      </surface>
    </collision>

    <collision name="front_support_collision">
      <pose>0.28 0 0.06 0 0 0</pose>
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <surface><friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction></surface>
    </collision>

    <collision name="rear_support_collision">
      <pose>-0.28 0 0.06 0 0 0</pose>
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <surface><friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction></surface>
    </collision>

    <visual name="body">
      <pose>0 0 0.18 0 0 0</pose>
      <geometry><box><size>0.56 0.34 0.18</size></box></geometry>
      <material><ambient>1.0 0.55 0.02 1</ambient><diffuse>1.0 0.55 0.02 1</diffuse></material>
    </visual>

    <visual name="counterweight">
      <pose>-0.28 0 0.25 0 0 0</pose>
      <geometry><box><size>0.18 0.36 0.28</size></box></geometry>
      <material><ambient>0.95 0.42 0.0 1</ambient><diffuse>0.95 0.42 0.0 1</diffuse></material>
    </visual>

    <visual name="cabin">
      <pose>-0.10 0 0.40 0 0 0</pose>
      <geometry><box><size>0.24 0.27 0.30</size></box></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
    </visual>

    <visual name="window">
      <pose>0.025 0 0.43 0 0 0</pose>
      <geometry><box><size>0.012 0.23 0.16</size></box></geometry>
      <material><ambient>0.1 0.45 0.75 0.85</ambient><diffuse>0.1 0.45 0.75 0.85</diffuse></material>
    </visual>

    <visual name="mast_left">
      <pose>0.29 0.11 0.34 0 0 0</pose>
      <geometry><box><size>0.035 0.035 0.55</size></box></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
    </visual>

    <visual name="mast_right">
      <pose>0.29 -0.11 0.34 0 0 0</pose>
      <geometry><box><size>0.035 0.035 0.55</size></box></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
    </visual>

    <visual name="fork_left">
      <pose>0.47 0.075 0.065 0 0 0</pose>
      <geometry><box><size>0.38 0.035 0.025</size></box></geometry>
      <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
    </visual>

    <visual name="fork_right">
      <pose>0.47 -0.075 0.065 0 0 0</pose>
      <geometry><box><size>0.38 0.035 0.025</size></box></geometry>
      <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
    </visual>

    <visual name="front_caster_visual">
      <pose>0.28 0 0.06 0 0 0</pose>
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
    </visual>

    <visual name="rear_caster_visual">
      <pose>-0.28 0 0.06 0 0 0</pose>
      <geometry><sphere><radius>0.055</radius></sphere></geometry>
      <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
    </visual>
  </link>

  <link name="left_wheel">
    <pose>0 0.19 0.07 1.5708 0 0</pose>
    <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
    <collision name="collision"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
    <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
  </link>

  <link name="right_wheel">
    <pose>0 -0.19 0.07 1.5708 0 0</pose>
    <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
    <collision name="collision"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
    <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
  </link>

  <joint name="left_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>left_wheel</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.2</damping></dynamics></axis>
  </joint>

  <joint name="right_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>right_wheel</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.2</damping></dynamics></axis>
  </joint>

  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.38</wheel_separation>
    <wheel_radius>0.07</wheel_radius>
    <topic>/model/forklift_1/cmd_vel</topic>
    <odom_publish_frequency>20</odom_publish_frequency>
    <max_linear_acceleration>0.4</max_linear_acceleration>
    <max_angular_acceleration>0.8</max_angular_acceleration>
  </plugin>
</model>


