  <joint name="right_rear_wheel_joint" type="continuous">
    <origin xyz="-0.0800000000000001 -0.0816000000000001 0.01" rpy="-1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="right_rear_wheel" />
    <axis xyz="0 0 -1" />
  </joint>

  <joint name="right_front_wheel_joint" type="continuous">
    <origin xyz="0.08 -0.10326 0.0100000000000002" rpy="-1.5707963267949 0 0" />
